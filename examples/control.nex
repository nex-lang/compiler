@import fprint, input from std.io;

: fn main => () {
    var int: param = 10;
    var int[]: array = {10, 100, 1000, 100000};  


    for (var: j = 1; j < param; j++) {
        if (param > j) {
            fprint(1);
        } elif (param == 1) {
            fprint(2);
            fprint(0);
        }
    }

    for (var: i = 1 : 10) {
        fprint(i);
    }


    for (var: i = 1 :: array) {
        fprint(i);
    }

    var int: test_var = 10;

    var: x = 10;

    while (x >= 100) {
        x += 1;
    }

    var: options = 2;
    var: operation;

    switch (options) {
        case 1:
            operation = "multiplication";
            break;
        case 2:
            operation = "addition";
            break;
        default: break;
    }


    // note: this is an extremely random program

    return 0;
}