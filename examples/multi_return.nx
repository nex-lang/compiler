[(double), (float)] : fn returns_double_and_float => () {
    return 1.1d, 1.1f;
}

[(double, float), (float, double)] : fn returns_two_double_or_float => () {
    return 1.1d, 1.1f;
}

(float, double) : fn returns_floatordouble => () {
    return 1.1f;
}

double : fn returns_double => () {
    return 1.1d;
}

fn returns_anything => () {
    return "1.1d";
}

: fn main => () {
    returns_double_and_float();
    returns_two_double_or_float();
    returns_floatordouble();
    returns_double();
    returns_anything();

    return 0;
}